# Xcode 프로젝트는 XcodeGen(project.yml)으로 CI에서 생성한다. 커밋하지 않는다.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved
*.o
*.swiftmodule

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# 로컬 에이전트 설정 및 서드파티 스킬.
# 이 저장소는 공개이므로, 라이선스가 우리 것이 아닌 스킬 소스를 재배포하지 않는다.
# (skills 는 각자 자기 머신에 설치한다)
.claude/

# 서명 자산 — 절대 커밋 금지 (GitHub Secrets로만 관리)
signing/
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.key
*.pem

# Firebase(FCM) 설정. 프로젝트 식별자가 들어 있고 저장소가 공개이므로 커밋하지 않는다.
# Firebase 콘솔에서 iOS 앱을 등록하고 내려받아 App/Resources/ 에 둔다.
App/Resources/GoogleService-Info.plist

# 환경 설정
# 개인별 빌드 설정. Config/Base.xcconfig 와 Local.example.xcconfig 는 커밋한다.
Config/Local.xcconfig
.env

# fastlane
fastlane/report.xml
fastlane/screenshots/
fastlane/test_output/

# CI 에서 내려받은 스크린샷·동영상 아티팩트
preview/
ipa/

# macOS / Windows
.DS_Store
Thumbs.db
